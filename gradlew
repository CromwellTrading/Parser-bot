#!/bin/sh
# SynthesisOne Gradle wrapper bootstrap. The wrapper JAR is generated by Gradle's
# official distribution (it is not published as a standalone binary), then verified
# against the official checksum before use.
set -eu
APP_NAME="Gradle"
APP_BASE_NAME=$(basename "$0")
DEFAULT_JVM_OPTS="-Xmx512m"
PRG="$0"
while [ -h "$PRG" ]; do
  ls_out=$(ls -ld "$PRG")
  link=$(expr "$ls_out" : '.*-> \(.*\)')
  case "$link" in /*) PRG="$link" ;; *) PRG=$(dirname "$PRG")"/$link" ;; esac
done
SAVED=$(pwd)
cd "$(dirname "$PRG")" >/dev/null
APP_HOME=$(pwd -P)
cd "$SAVED" >/dev/null
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
WRAPPER_SHA256="ed2c26eba7cfb93cc2b7785d05e534f07b5b48b5e7fc941921cd098628abca58"
DIST_SHA256="e111cb9948407e26351227dabce49822fb88c37ee72f1d1582a69c68af2e702f"
DIST_URL="https://services.gradle.org/distributions/gradle-8.1.1-bin.zip"
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
BOOTSTRAP_HOME="$GRADLE_USER_HOME/synthesisone-wrapper-bootstrap"
BOOTSTRAP_GRADLE="$BOOTSTRAP_HOME/gradle-8.1.1/bin/gradle"

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then openssl dgst -sha256 "$1" | awk '{print $NF}'
  else echo "ERROR: no existe sha256sum, shasum ni openssl." >&2; return 1; fi
}
verify_hash() {
  actual=$(sha256_file "$1")
  [ "$actual" = "$2" ] || { echo "ERROR: checksum incorrecto para $1; archivo rechazado." >&2; return 1; }
}

if [ ! -s "$WRAPPER_JAR" ]; then
  mkdir -p "$BOOTSTRAP_HOME"
  if [ ! -x "$BOOTSTRAP_GRADLE" ]; then
    command -v curl >/dev/null 2>&1 || { echo "ERROR: falta Gradle Wrapper y curl no está disponible." >&2; exit 1; }
    command -v unzip >/dev/null 2>&1 || { echo "ERROR: para generar el Wrapper se necesita unzip." >&2; exit 1; }
    dist_zip="$BOOTSTRAP_HOME/gradle-8.1.1-bin.zip.download.$$"
    trap 'rm -f "$dist_zip"' EXIT HUP INT TERM
    echo "Descargando Gradle 8.1.1 oficial para generar gradle-wrapper.jar…"
    curl --fail --location --silent --show-error --retry 3 --retry-all-errors --connect-timeout 10 --max-time 300 --output "$dist_zip" "$DIST_URL"
    verify_hash "$dist_zip" "$DIST_SHA256"
    unzip -q -o "$dist_zip" -d "$BOOTSTRAP_HOME"
    rm -f "$dist_zip"
    trap - EXIT HUP INT TERM
  fi
  tmp_project=$(mktemp -d "${TMPDIR:-/tmp}/so-wrapper-bootstrap.XXXXXX")
  trap 'rm -rf "$tmp_project"' EXIT HUP INT TERM
  printf "rootProject.name = 'synthesisone-wrapper-bootstrap'\n" > "$tmp_project/settings.gradle"
  : > "$tmp_project/build.gradle"
  "$BOOTSTRAP_GRADLE" --no-daemon -p "$tmp_project" wrapper --gradle-version 8.1.1 --distribution-type bin
  generated="$tmp_project/gradle/wrapper/gradle-wrapper.jar"
  [ -s "$generated" ] || { echo "ERROR: Gradle no generó gradle-wrapper.jar." >&2; exit 1; }
  verify_hash "$generated" "$WRAPPER_SHA256"
  mkdir -p "$(dirname "$WRAPPER_JAR")"
  cp "$generated" "$WRAPPER_JAR.download.$$"
  mv "$WRAPPER_JAR.download.$$" "$WRAPPER_JAR"
  rm -rf "$tmp_project"
  trap - EXIT HUP INT TERM
  echo "gradle-wrapper.jar generado y verificado con SHA-256 oficial."
fi
verify_hash "$WRAPPER_JAR" "$WRAPPER_SHA256"
exec java $DEFAULT_JVM_OPTS ${JAVA_OPTS:-} ${GRADLE_OPTS:-} \
  "-Dorg.gradle.appname=$APP_BASE_NAME" \
  -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
